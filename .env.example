# URL of the online Timeflow timesheet portal.
TIMESHEET_URL=https://timeflow.example.com/

# Credentials for auto-login (optional; leave unset to log in manually).
TIMESHEET_USER=your-username
TIMESHEET_PASSWORD=your-password

# Path to the source Excel file to copy into the 'sheet/' directory.
SHEET_SOURCE_PATH=/path/to/your/monthly report.xlsx

# Optional: numeric project ID of the box to fill (the number in projectTimeFormContainer<ID>).
# Leave unset to use the first box on the page. Run `uv run main.py list-boxes` to discover IDs.
# TIMESHEET_PROJECT_ID=1308
